# --- Sunucu ---
PORT=3000
TZ=Europe/Istanbul

# --- Veritabanı ---
# Canlıda (Railway vb.) Postgres bağlantısı. Boş bırakılırsa yerelde gömülü PGlite kullanılır.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Mağaza token'larını şifrelemek için 32 baytlık anahtar. Üretmek için:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Kaybederseniz kayıtlı WhatsApp token'ları çözülemez; güvenli saklayın.
MASTER_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
HISTORY_LIMIT=20

# --- Meta WhatsApp Cloud API (platform uygulaması) ---
# developers.facebook.com → Uygulamanız → Ayarlar → Temel → Uygulama Gizli Anahtarı
WHATSAPP_APP_SECRET=
# Webhook ayarında gireceğiniz, kendi belirlediğiniz rastgele metin
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# --- Shopify uygulaması (Dev Dashboard) ---
# Sunucunun dışarıdan erişilen adresi (yerelde ngrok adresi). Shopify yönlendirmesi buraya gelir.
APP_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
# Mağaza sayfa/politikalarının kontrol aralığı (dakika)
KNOWLEDGE_SYNC_MINUTES=15
